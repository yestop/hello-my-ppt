version: v2
title: "hello-my-ppt 使用介绍"
size: [960, 540]
theme:
  colors:
    primary: "#12304A"
    accent: "#2F80ED"
    accent2: "#FF7A45"
    bg: "#F5F8FC"
    surface: "#FFFFFF"
    text: "#132238"
    muted: "#5D7188"
    line: "#D9E4EF"
    green: "#20A486"
    purple: "#7654C5"
    primarySoft: "#E9F0F7"
    accentSoft: "#E8F2FF"
  textStyles:
    eyebrow: {fontFamily: "Microsoft YaHei", fontSize: 11, color: "$accent", bold: true, letterSpacing: 1.5, lineHeight: 1.3}
    title: {fontFamily: "Microsoft YaHei", fontSize: 30, color: "$text", bold: true, lineHeight: 1.2}
    subtitle: {fontFamily: "Microsoft YaHei", fontSize: 14, color: "$muted", lineHeight: 1.5}
    body: {fontFamily: "Microsoft YaHei", fontSize: 13, color: "$text", lineHeight: 1.5}
    small: {fontFamily: "Microsoft YaHei", fontSize: 10, color: "$muted", lineHeight: 1.35}
    code: {fontFamily: "Consolas", fontSize: 12, color: "#EAF2FF", lineHeight: 1.5}
pages:
  - pages/01_cover.page
  - pages/02_workflow.page
  - pages/03_inputs.page
  - pages/04_capabilities.page
  - pages/05_templates.page
  - pages/06_commands.page
  - pages/07_prompt_to_deck.page
  - pages/08_start.page
